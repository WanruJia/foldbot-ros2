<?xml version="1.0"?>
<package format="3">
  <name>foldbot_runtime</name>
  <version>0.1.0</version>
  <description>ROS 2 adapters for the FoldBot Python behaviour tree.</description>
  <maintainer email="maintainers@example.com">FoldBot maintainers</maintainer>
  <license>TODO</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>foldbot_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>py_trees</exec_depend>
